<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TaskManager Pro</title>
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top custom-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/tasks">
                <i class="bi bi-check2-square text-primary fs-4"></i>
                <span>TasksManager</span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" 
                aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link fw-medium" href="/tasks">Minhas Tasks</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium" href="/tasks/add">
                            <i class="bi bi-plus-circle me-1"></i> Nova Task
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <!-- Toggle Light/Dark Mode -->
                    <button class="btn theme-toggle-btn rounded-circle p-2 d-flex align-items-center justify-content-center" id="themeToggleBtn" title="Alternar Tema">
                        <i class="bi bi-moon-stars-fill fs-5" id="themeIcon"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Conteúdo Dinâmico -->
    <main class="flex-grow-1">
        {{{body}}}
    </main>

    <!-- Footer -->
    <footer class="py-3 text-center text-secondary border-top fs-7 mt-auto">
        <div class="container">
            <small>&copy; TaskManager Pro - Gerenciador de Tarefas</small>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Scripts do tema -->
    <script src="/js/main.js"></script>
</body>

</html>